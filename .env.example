# =========================================================
# Hyperion environment template
# Copy this file to .env in the project root and fill in the values.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit the real .env file.
# =========================================================

# ---------- Frontend-safe values (included in the browser bundle) ----------
# Supabase Dashboard > Project Settings > API Keys
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Only needed when frontend and backend are deployed on different domains.
# VITE_API_URL=https://your-backend-domain.example.com

# ---------- Backend-only values (never exposed to the browser) ----------
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Leave empty unless your project still signs access tokens with an HS256 secret.
SUPABASE_JWT_SECRET=

# Google Gemini > API key from https://aistudio.google.com/app/apikey
# The backend calls Gemini directly and keeps this key server-side.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Any current id from https://ai.google.dev/gemini-api/docs/models (retired ids are skipped).
GEMINI_MODEL=gemini-3.6-flash

# Alpha Vantage > API key (live finance news)
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_KEY
ALPHAVANTAGE_NEWS_TOPICS=financial_markets

# Finnhub > API key (live stock and crypto quotes)
FINNHUB_API_KEY=YOUR_FINNHUB_KEY

# Local development only. Set to false in production.
ALLOW_DEMO_AUTH=true

# Chat rate limiting, per user (sliding window). Defaults if unset: 20 per 300s.
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=300

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
